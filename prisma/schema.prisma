generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
  instructor
  member
}

enum MemberStatus {
  active
  inactive
  suspended
  trial
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum DisciplineCategory {
  sport
  art
  wellness
  academic
  other
}

enum BillingPeriod {
  monthly
  quarterly
  semi_annual
  annual
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum EnrollmentStatus {
  active
  cancelled
  completed
}

enum AttendanceStatus {
  present
  absent
  late
  justified
}

enum PaymentMethod {
  cash
  card
  transfer
  other
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(member)
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member             Member?
  instructorClasses  Class[]      @relation("InstructorClasses")
  attendanceChecks   Attendance[] @relation("CheckedBy")
  processedPayments  Payment[]    @relation("ProcessedBy")

  @@map("users")
}

model Member {
  id               String       @id @default(uuid())
  userId           String       @unique @map("user_id")
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  dni              String       @unique
  phone            String?
  dateOfBirth      DateTime     @map("date_of_birth") @db.Date
  gender           Gender?
  address          String?
  emergencyContact String?      @map("emergency_contact")
  emergencyPhone   String?      @map("emergency_phone")
  photoUrl         String?      @map("photo_url")
  planId           String?      @map("plan_id")
  status           MemberStatus @default(trial)
  enrollmentDate   DateTime     @default(now()) @map("enrollment_date") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan?        @relation(fields: [planId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]
  payments    Payment[]

  @@index([status])
  @@index([planId])
  @@map("members")
}

model Discipline {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  category    DisciplineCategory
  maxCapacity Int                @map("max_capacity")
  isActive    Boolean            @default(true) @map("is_active")
  imageUrl    String?            @map("image_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  classes        Class[]
  enrollments    Enrollment[]
  planDisciplines PlanDiscipline[]

  @@index([category])
  @@index([isActive])
  @@map("disciplines")
}

model Plan {
  id              String        @id @default(uuid())
  name            String        @unique
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  billingPeriod   BillingPeriod @map("billing_period")
  maxDisciplines  Int?          @map("max_disciplines")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  members         Member[]
  planDisciplines PlanDiscipline[]

  @@index([isActive])
  @@map("plans")
}

model PlanDiscipline {
  id           String @id @default(uuid())
  planId       String @map("plan_id")
  disciplineId String @map("discipline_id")

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([planId, disciplineId])
  @@map("plan_disciplines")
}

model Class {
  id           String    @id @default(uuid())
  disciplineId String    @map("discipline_id")
  instructorId String    @map("instructor_id")
  name         String
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  location     String?
  maxCapacity  Int       @map("max_capacity")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  discipline  Discipline   @relation(fields: [disciplineId], references: [id])
  instructor  User         @relation("InstructorClasses", fields: [instructorId], references: [id])
  attendances Attendance[]

  @@index([disciplineId])
  @@index([instructorId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("classes")
}

model Enrollment {
  id           String           @id @default(uuid())
  memberId     String           @map("member_id")
  disciplineId String           @map("discipline_id")
  status       EnrollmentStatus @default(active)
  enrolledAt   DateTime         @default(now()) @map("enrolled_at")
  cancelledAt  DateTime?        @map("cancelled_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id])

  @@unique([memberId, disciplineId, status])
  @@index([memberId])
  @@index([disciplineId])
  @@map("enrollments")
}

model Attendance {
  id        String           @id @default(uuid())
  memberId  String           @map("member_id")
  classId   String           @map("class_id")
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?
  checkedBy String?          @map("checked_by")
  createdAt DateTime         @default(now()) @map("created_at")

  member  Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id])
  checker User?  @relation("CheckedBy", fields: [checkedBy], references: [id])

  @@unique([memberId, classId, date])
  @@index([date])
  @@index([classId])
  @@map("attendances")
}

model Payment {
  id            String        @id @default(uuid())
  memberId      String        @map("member_id")
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("ARS")
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(pending)
  description   String?
  periodStart   DateTime      @map("period_start") @db.Date
  periodEnd     DateTime      @map("period_end") @db.Date
  paidAt        DateTime?     @map("paid_at")
  receiptNumber String?       @unique @map("receipt_number")
  processedBy   String?       @map("processed_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  processor User?  @relation("ProcessedBy", fields: [processedBy], references: [id])

  @@index([memberId])
  @@index([status])
  @@index([periodStart])
  @@map("payments")
}
