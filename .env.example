NODE_ENV=development
PORT=3000

# Base de datos
DATABASE_URL=postgresql://tribuscript:tribuscript@localhost:5432/tribuscript

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=cambiar-por-secreto-seguro-min-32-chars
